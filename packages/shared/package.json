{
  "name": "@finex/shared",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "exports": {
    "./*.js": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./**/*.js": {
      "types": "./dist/**/*.d.ts",
      "default": "./dist/**/*.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "effect": "^3.21.2"
  },
  "devDependencies": {
    "typescript": "~6.0.3"
  }
}
