# API runtime
NODE_ENV=development
PORT=3000
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=postgres://app:app@127.0.0.1:5433/finex_db

# JWT configuration
# Replace both placeholders with distinct secrets of at least 32 characters.
JWT_ACCESS_SECRET=replace-with-local-access-secret-32-chars-minimum
JWT_REFRESH_SECRET=replace-with-local-refresh-secret-32-chars-minimum
JWT_ISSUER=finex-api
JWT_AUDIENCE=finex-web
JWT_ACCESS_EXPIRES_IN_SECONDS=900
JWT_REFRESH_EXPIRES_IN_SECONDS=604800
