{
  "name": "@finex/web",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node ../../scripts/check-web-architecture.mjs app && react-router build",
    "check:architecture": "node ../../scripts/check-web-architecture.mjs app",
    "dev": "react-router dev",
    "pretest": "pnpm --filter @finex/shared build",
    "test": "node ../../scripts/check-web-architecture.mjs app && node ../../scripts/check-focused-tests.mjs app && tsx --test app/**/*.test.ts app/**/**/*.test.ts app/**/*.test.tsx app/**/**/*.test.tsx",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "node ../../scripts/check-web-architecture.mjs app && react-router typegen && tsc"
  },
  "dependencies": {
    "@finex/shared": "workspace:*",
    "@react-router/node": "7.16.0",
    "@react-router/serve": "7.16.0",
    "effect": "^3.21.2",
    "isbot": "^5.1.36",
    "lucide-react": "^1.18.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router": "7.16.0"
  },
  "devDependencies": {
    "@react-router/dev": "7.16.0",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^22",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.22.3",
    "typescript": "^5.9.3",
    "vite": "^8.0.3"
  }
}
